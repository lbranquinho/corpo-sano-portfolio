# Corpo Sano — PRODUÇÃO (copie para .env na pasta /opt/corposano)
# Chaves EXCLUSIVAS deste ambiente. Guarde BACKUP_ENCRYPTION_KEY também fora do servidor (cofre de senhas).
COMPOSE_PROJECT_NAME=corposano
ENVIRONMENT=production
DEBUG=false
PUBLIC_BASE_URL=https://sistema.suaclinica.com.br
DOMAIN=sistema.suaclinica.com.br
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=latest

POSTGRES_DB=corposano
POSTGRES_USER=corposano
POSTGRES_PASSWORD=

SECRET_KEY=
ENCRYPTION_KEYS=
HEALTH_ENCRYPTION_KEYS=
BACKUP_ENCRYPTION_KEY=
COOKIE_SECURE=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=
TIMEZONE=America/Sao_Paulo
API_WORKERS=2

INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

BACKUP_RETENTION_DAYS=30
BACKUP_DAILY_HOUR=3
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=corpo-sano/producao/
LETSENCRYPT_EMAIL=
MAX_UPLOAD_MB=15
