# Corpo Sano — Nginx para execução LOCAL (desenvolvimento) sem TLS.
# Nunca use esta configuração em servidor acessível pela internet.

limit_req_zone $binary_remote_addr zone=cs_api:10m rate=20r/s;
limit_req_status 429;

server {
    listen 80;
    server_name _;
    server_tokens off;
    client_max_body_size 20m;
    include /etc/nginx/snippets/security-headers.conf;
    root /usr/share/nginx/html;

    location /api/ {
        limit_req zone=cs_api burst=60 nodelay;
        proxy_pass http://api:8000;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        try_files $uri /index.html;
    }
}
