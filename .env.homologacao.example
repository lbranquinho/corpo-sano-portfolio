# Corpo Sano — HOMOLOGAÇÃO (copie para .env na pasta /opt/corposano-homologacao)
# Use banco, chaves, certificado e domínio próprios. Emissão fiscal: "produção restrita" do Sistema Nacional NFS-e.
COMPOSE_PROJECT_NAME=corposano-homolog
ENVIRONMENT=homologation
DEBUG=false
PUBLIC_BASE_URL=https://homologacao.suaclinica.com.br
DOMAIN=homologacao.suaclinica.com.br
# Se produção e homologação estiverem no MESMO servidor, use um proxy na frente ou outras portas.
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=latest

POSTGRES_DB=corposano_homolog
POSTGRES_USER=corposano
POSTGRES_PASSWORD=

SECRET_KEY=
ENCRYPTION_KEYS=
HEALTH_ENCRYPTION_KEYS=
BACKUP_ENCRYPTION_KEY=
COOKIE_SECURE=true
CORS_ORIGINS=
TIMEZONE=America/Sao_Paulo
API_WORKERS=2

INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

BACKUP_RETENTION_DAYS=14
BACKUP_DAILY_HOUR=3
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=corpo-sano/homologacao/
LETSENCRYPT_EMAIL=
