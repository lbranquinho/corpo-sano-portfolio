# =============================================================================
# Corpo Sano — variáveis de ambiente (MODELO).
# Copie para ".env" na pasta do ambiente e preencha. NUNCA versione o .env real.
# Gere as chaves com:  docker compose run --rm api python -m app.cli generate-keys
# =============================================================================

# --- Identificação do ambiente -------------------------------------------------
COMPOSE_PROJECT_NAME=corposano-local
# development | homologation | production
ENVIRONMENT=development
DEBUG=false
# URL pública (HTTPS obrigatório em homologação/produção)
PUBLIC_BASE_URL=http://localhost:8080
# Domínio atendido pelo Nginx (homologação/produção)
DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
IMAGE_TAG=latest

# --- Banco de dados PostgreSQL ---------------------------------------------------
POSTGRES_DB=corposano
POSTGRES_USER=corposano
POSTGRES_PASSWORD=trocar-por-senha-forte

# --- Segurança (gere valores reais!) --------------------------------------------
SECRET_KEY=trocar-por-chave-aleatoria-de-48-caracteres-ou-mais
ENCRYPTION_KEYS=trocar-por-chave-fernet
HEALTH_ENCRYPTION_KEYS=trocar-por-outra-chave-fernet
BACKUP_ENCRYPTION_KEY=trocar-por-chave-base64-de-32-bytes
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Origens adicionais para CORS (normalmente vazio: front e API no mesmo domínio)
CORS_ORIGINS=
TIMEZONE=America/Sao_Paulo
API_WORKERS=2

# --- Primeiro acesso (usado apenas se não existir nenhum usuário) ----------------
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Backups ---------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
BACKUP_DAILY_HOUR=3
# Cópia externa (S3 compatível: AWS S3, Backblaze B2, Wasabi, MinIO...). Fortemente recomendado.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=corpo-sano/

# --- Uploads ---------------------------------------------------------------------
MAX_UPLOAD_MB=15
